    "framer-motion": "12.23.28",
    "lucide-react": "1.61.0",
    "next": "15.5.28",
    "pdfjs-dist": "4.10.38",
    "postgres": "3.4.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "recharts": "2.15.4",
    "tailwind-merge": "3.7.0",
