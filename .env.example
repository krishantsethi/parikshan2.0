# ============================================================================
# PARIKSHAN — environment configuration
# Copy to `.env.local` for development. NEVER commit real secrets.
# Every variable is OPTIONAL: with none set, the app boots in clearly-labeled
# DEMO MODE (in-memory store, volatile data, AI disabled, local OCR).
# ============================================================================

# --- Core -------------------------------------------------------------------
# Public origin of the deployed app (used in links/metadata).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign/derive session-material and password-reset tokens.
# REQUIRED for any real deployment. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Session lifetime in hours (default: 168 = 7 days).
SESSION_TTL_HOURS=168

# --- Framing / embed policy ---------------------------------------------------
# Which origins may embed PARIKSHAN in an <iframe>. Space-separated CSP
# `frame-ancestors` source list.
#
#   (unset)                                 -> 'self' only, plus
#                                              X-Frame-Options: DENY.
#                                              This is the hardened default and
#                                              the correct setting for any
#                                              environment holding real
#                                              patient data.
#   'self' https://app.example.com          -> allow one named parent origin
#   *                                       -> allow ANY parent.
#                                              PREVIEW / SANDBOX ONLY — never
#                                              use with real health data, it
#                                              permits clickjacking of the UI.
#
# Needed to view the app inside sandbox or Vercel preview panels, which frame
# it from a different origin than the app itself.
FRAME_ANCESTORS=

# --- Database (Supabase Postgres / Neon / any Postgres 14+) -----------------
# A direct Postgres connection string. For Supabase: Project Settings ->
# Database -> Connection string (use the *session/pooler* string, db user with
# DDL rights for migrations). When unset, PARIKSHAN runs the in-memory demo
# store and all persisted data is volatile.
DATABASE_URL=

# Run migrations automatically on server start (recommended: false; run
# `npm run db:migrate` explicitly instead).
DB_AUTOMIGRATE=false

# --- File storage ------------------------------------------------------------
# Where uploaded medical documents are kept.
#   auto       -> Postgres (when DATABASE_URL set) else memory (demo)
#   postgres   -> force Postgres bytea storage
#   memory     -> force volatile in-memory storage (demo)
STORAGE_DRIVER=auto

# Per-file upload limit in MB (hard cap 25).
UPLOAD_MAX_MB=10

# --- AI provider (OpenAI-compatible) -----------------------------------------
# Server-side only. Used for report explanations and the grounded assistant.
# When unset, AI features degrade honestly: the assistant and summaries say
# "AI provider not configured" and never fabricate answers.
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (OpenAI, Azure OpenAI proxy, OpenRouter...).
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
# Max tokens for assistant replies.
AI_MAX_TOKENS=900

# --- OCR ---------------------------------------------------------------------
# OCR_PROVIDER=tesseract -> local OCR via tesseract.js (works with no cloud
#   credentials; downloads language data on first use in serverless envs).
# OCR_PROVIDER=none      -> digital-PDF text extraction only.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng

# --- Medication interaction sources ------------------------------------------
# Curated starter dataset is always on (clearly labeled, not exhaustive).
# OpenFDA adds live drug-interaction lookups (free, optional API key raises
# rate limits). Set OPENFDA_ENABLED=true to use it at runtime.
OPENFDA_ENABLED=false
OPENFDA_API_KEY=

# --- Rate limiting ------------------------------------------------------------
# Requests per window per IP for sensitive endpoints (in-memory; use a shared
# store such as Upstash Redis for multi-instance production deployments).
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Demo seed ----------------------------------------------------------------
# Seed the clearly-labeled demo account (demo@parikshan.health) in demo mode.
DEMO_MODE=true
